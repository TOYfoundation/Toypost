# Port und öffentliche Adresse der API
PORT=8787
PUBLIC_URL=http://localhost:8787
# Erlaubte Herkunft der App (CORS), mehrere mit Komma
APP_ORIGIN=http://localhost:8081

# Geheimnis für Token-Signatur und Verschlüsselung der Zugangsdaten. Mindestens 32 Zeichen, niemals einchecken.
TOYPOST_SECRET=bitte-durch-einen-langen-zufallswert-ersetzen

# Datenbankdatei (SQLite). Für große Installationen ist ein Postgres-Adapter vorgesehen.
DATABASE_PATH=./data/toypost.sqlite
# Ablage für hochgeladene Dateien, wenn kein Paperless verbunden ist
FILES_PATH=./data/files

# KI-Anbieter: mock | anthropic | ollama
AI_PROVIDER=mock
ANTHROPIC_API_KEY=
AI_MODEL_FAST=claude-haiku-5-5
AI_MODEL_SMART=claude-sonnet-5-5
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

# Zahlungsanbieter: dev (Entwicklung, bucht sofort) – Stripe oder Paddle als Adapter ergänzen
PAYMENT_PROVIDER=dev

# ---------- ToyPost: Toy-Projekte und Kanäle ----------
# Erlaubte Chain-IDs beim Anmelden mit Adresse (EIP-4361), mehrere mit Komma. Leer = jede, bis ToyChain eine feste ID hat.
TOYCHAIN_CHAIN_IDS=
# Domain für Anmelden mit Adresse, Standard: Host von PUBLIC_URL
SIWE_DOMAIN=
# Abruf von Feeds, GitHub und ToyScan im Hintergrund
SCHEDULER=true
# Fehlerberichte an Sentry (Projekt "toypost-api"). Ohne Inhalte, Geheimnisse geschwärzt. Leer = aus.
SENTRY_DSN=
