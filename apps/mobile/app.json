{
  "expo": {
    "name": "ToyPost",
    "slug": "toypost",
    "scheme": "toypost",
    "version": "0.1.0",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "de.toypost.app",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "ToyPost nutzt die Kamera, um Briefe zu scannen.",
        "NSPhotoLibraryUsageDescription": "ToyPost liest Fotos von Briefen aus deiner Mediathek."
      }
    },
    "android": {
      "package": "de.toypost.app",
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F3F5F7"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "cameraPermission": "ToyPost nutzt die Kamera, um Briefe zu scannen.",
          "photosPermission": "ToyPost liest Fotos von Briefen aus deiner Mediathek."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "apiUrl": "http://localhost:8787"
    },
    "icon": "./assets/icon.png"
  }
}