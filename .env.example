# Für docker compose. Kopieren nach .env und alle Werte ersetzen.
TOYPOST_SECRET=ersetzen-durch-mindestens-32-zufaellige-zeichen
TOYPOST_PUBLIC_URL=http://localhost:8787
AI_PROVIDER=mock
ANTHROPIC_API_KEY=

PAPERLESS_SECRET_KEY=ersetzen-durch-langen-zufallswert
PAPERLESS_ADMIN_USER=admin
PAPERLESS_ADMIN_PASSWORD=ersetzen

NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=ersetzen

# Nach der Registrierung in ToyPost eintragen (Konto → Verbindungen)
TOYPOST_ACCOUNT_ID=
TOYPOST_WEBHOOK_SECRET=
