# Für docker compose. Kopieren nach .env und alle Werte ersetzen.
DOKUFY_SECRET=ersetzen-durch-mindestens-32-zufaellige-zeichen
DOKUFY_PUBLIC_URL=http://localhost:8787
AI_PROVIDER=mock
ANTHROPIC_API_KEY=

PAPERLESS_SECRET_KEY=ersetzen-durch-langen-zufallswert
PAPERLESS_ADMIN_USER=admin
PAPERLESS_ADMIN_PASSWORD=ersetzen

NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=ersetzen

# Nach der Registrierung in Dokufy eintragen (Konto → Verbindungen)
DOKUFY_ACCOUNT_ID=
DOKUFY_WEBHOOK_SECRET=
