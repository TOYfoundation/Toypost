{
  "name": "toypost",
  "private": true,
  "version": "0.1.0",
  "description": "ToyPost – Korrespondenz-Assistent auf Basis von Paperless-ngx, Nextcloud und n8n",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "api": "npm run dev --workspace @toypost/api",
    "app": "npm run start --workspace @toypost/mobile",
    "app:web": "npm run web --workspace @toypost/mobile",
    "test": "npm run test --workspace @toypost/shared && npm run test --workspace @toypost/api",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "~5.9.2"
  }
}
